# =============================================================================
# WAX Prep — Railway / production environment contract
# =============================================================================
# Copy into Railway Variables (or a local .env for development).
# Full operator guide: docs/RAILWAY.md
# Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED (production will not run correctly without these)
# -----------------------------------------------------------------------------

# production | staging | development | test
APP_ENV=production

# Strong random string (not "change-me")
SECRET_KEY=

# Public HTTPS origin of the WEB service (no trailing slash).
# Used for webhooks and Surface URLs.
# Example: https://web-production-xxxx.up.railway.app
PUBLIC_BASE_URL=

# Railway Postgres: reference the plugin variable, e.g.
#   ${{Postgres.DATABASE_URL}}
# App accepts postgres:// and postgresql:// and normalizes to asyncpg.
DATABASE_URL=

# AI path (OpenAI-compatible HTTP API)
PRIMARY_PROVIDER=openai
PRIMARY_API_KEY=
PRIMARY_MODEL=gpt-4o-mini

# Student Worlds — must be on a durable volume in production.
# There is ONE durable student World tree, not one per service. Railway Volumes
# are attached per service, so separate mounts are NOT automatically shared.
#
# Correct shared-World setup:
#   - Use ONE Railway Volume and attach it to every service that needs World
#     access, mounted at the SAME path (e.g. /data) on each.
#   - Or use a real shared filesystem / object store that both services can
#     reach, and point WORKSPACE_ROOT at that shared store.
#
# Do NOT rely on two separate Railway Volumes being the same World.
# Mount a Railway Volume at /data, then:
WORKSPACE_ROOT=/data/wax-workspaces
REQUIRE_PERSISTENT_WORKSPACE=true

# -----------------------------------------------------------------------------
# REQUIRED for each channel you enable (leave disabled if unused)
# -----------------------------------------------------------------------------

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL (defaults are fine; set only when you need them)
# -----------------------------------------------------------------------------

APP_NAME=WAX Prep
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true

# Optional dedicated host for Surfaces; empty = same origin as PUBLIC_BASE_URL
SURFACE_PUBLIC_ORIGIN=

# Custom OpenAI-compatible base URL (Azure, proxy, etc.)
PRIMARY_BASE_URL=
PRIMARY_TIMEOUT_SECONDS=60
PRIMARY_MAX_RETRIES=2

# Same-task fallback if primary fails (not a second brain). Default: off.
FALLBACK_PROVIDER=none
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_TIMEOUT_SECONDS=60
FALLBACK_MAX_RETRIES=2

WHATSAPP_API_VERSION=v21.0
WHATSAPP_MAX_MESSAGE_CHARS=3500
TELEGRAM_MAX_MESSAGE_CHARS=4000
WEBHOOK_SIGNATURE_REQUIRED=true

# Artifacts: local (on volume) or s3-compatible
STORAGE_BACKEND=local
WAX_STORAGE_BACKEND=
WAX_ARTIFACT_ROOT=/data/wax-artifacts
WAX_S3_BUCKET=
WAX_S3_ENDPOINT=
WAX_S3_REGION=auto
WAX_S3_ACCESS_KEY=
WAX_S3_SECRET_KEY=
WAX_S3_PREFIX=wax/

# Railway Volumes are one-per-service. Student Worlds live on the WORKER volume.
# Do not create a second independent World copy on Web. Use S3 for multi-service artifacts.
# WAX_SHARED_STORE_PATH is a deprecated alias of WORKSPACE_ROOT only.

# World isolation (infrastructure safety)
ISOLATION_ENABLED=true
ISOLATION_TIMEOUT_SECONDS=45
ISOLATION_MAX_OUTPUT_BYTES=150000
ISOLATION_CPU_SECONDS=20
ISOLATION_MEMORY_BYTES=536870912
ISOLATION_REQUIRE_SANDBOX=false
ISOLATION_USE_DOCKER=false
WORKSPACE_TMP_TTL_HOURS=48
WORKSPACE_MAX_FILE_BYTES=25000000
# Alias also read by World layout code:
WAX_WORKSPACE_ROOT=

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

WORK_POLL_INTERVAL_SECONDS=1
WORK_STALE_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=5
DELIVERY_CHUNK_DELAY_SECONDS=0.55

RATE_LIMIT_ENABLED=true
RATE_BURST_CAPACITY=12
RATE_SUSTAINED_PER_MINUTE=30
RATE_WINDOW_SECONDS=60
RATE_COOLDOWN_SECONDS=15
RATE_QUEUE_LIMIT_PER_PRINCIPAL=40

RECOVERY_BATCH_WINDOW_SECONDS=90
RECOVERY_MAX_BATCH_SIZE=8
RECOVERY_POLL_INTERVAL_SECONDS=5
OUTAGE_AWARENESS_MIN_SECONDS=30
PROVIDER_RATE_LIMIT_MAX_RETRIES=48

# -----------------------------------------------------------------------------
# LOCAL-ONLY (do not set these for Railway production)
# -----------------------------------------------------------------------------
# APP_ENV=development
# DATABASE_URL=postgresql+asyncpg://wax:wax@localhost:5432/wax
# WORKSPACE_ROOT=/tmp/wax-workspaces
# REQUIRE_PERSISTENT_WORKSPACE=false
# PUBLIC_BASE_URL=http://localhost:8000
# PRIMARY_API_KEY=sk-...
