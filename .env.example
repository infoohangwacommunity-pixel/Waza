# WAX Prep environment example — copy to .env and fill values

APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://wax:wax@localhost:5432/wax

# Intelligence (required for real tutoring)
PRIMARY_PROVIDER=openai
PRIMARY_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
# PRIMARY_BASE_URL=https://api.openai.com/v1
# For Grok/xAI: PRIMARY_PROVIDER=grok PRIMARY_BASE_URL=https://api.x.ai/v1

FALLBACK_PROVIDER=none
FALLBACK_API_KEY=
FALLBACK_MODEL=

MEMORY_PROVIDER=none
MEMORY_API_KEY=
MEMORY_MODEL=gpt-4o-mini

# Optional multimodal fallback (prefer local OCR first)
MULTIMODAL_PROVIDER=none
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=gpt-4o-mini

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Terminal / AI workspace
TERMINAL_ENABLED=true
WORKSPACE_ROOT=/tmp/wax-workspaces
WORKSPACE_TTL_HOURS=72
