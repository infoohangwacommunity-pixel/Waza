# =============================================================================
# WAX Prep — environment template (copy into Railway Variables / local .env)
# =============================================================================
# After deploy, set PUBLIC_BASE_URL to your Railway WEB service URL, e.g.
#   https://web-production-b83b4.up.railway.app
# =============================================================================

# --- App ---
APP_ENV=production
APP_NAME=WAX Prep
SECRET_KEY=GENERATE_A_LONG_RANDOM_STRING
PUBLIC_BASE_URL=https://YOUR-WEB-SERVICE.up.railway.app
# Alias also accepted: WAX_PUBLIC_BASE_URL
# Surfaces use PUBLIC_BASE_URL (same origin) by default — no extra domain required.
# Optional: SURFACE_PUBLIC_ORIGIN for an advanced dedicated Surface host only.
# Leave empty for normal Railway same-origin deployment.
SURFACE_PUBLIC_ORIGIN=

# --- Database (Railway: use reference variable from Postgres service) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- LLM (required for tutoring) ---
PRIMARY_PROVIDER=openai
PRIMARY_API_KEY=
PRIMARY_BASE_URL=
PRIMARY_MODEL=gpt-4o-mini
PRIMARY_TIMEOUT_SECONDS=60
PRIMARY_MAX_RETRIES=2
# Optional WAX_* aliases mapped at startup:
# WAX_LLM_API_KEY=  WAX_LLM_BASE_URL=  WAX_LLM_MODEL=

FALLBACK_PROVIDER=none
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=gpt-4o-mini

# --- Policy / agent ---
# No AGENT_MAX_TOOL_ROUNDS / intelligence budgets.
# Agent safety ceilings (wall time, runaway continuations) live in code as infrastructure only.
ALLOW_CODE_EXECUTION=true
ALLOW_EXTERNAL_NETWORK=true
ALLOW_HTML_ARTIFACTS=true

# --- WhatsApp Cloud API ---
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=wax-default-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MAX_MESSAGE_CHARS=3500
# Webhook URL: {PUBLIC_BASE_URL}/webhooks/whatsapp

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_MESSAGE_CHARS=4000
# Webhook URL: {PUBLIC_BASE_URL}/webhooks/telegram
# setWebhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<PUBLIC_BASE_URL>/webhooks/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>

# --- Storage (artifacts / mini pages) ---
# Prefer S3-compatible on Railway (Bucket) for durability across deploys:
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# WAX_STORAGE_BACKEND=s3
WAX_S3_BUCKET=
WAX_S3_ENDPOINT=
WAX_S3_REGION=auto
WAX_S3_ACCESS_KEY=
WAX_S3_SECRET_KEY=
WAX_S3_PREFIX=wax/
# Local artifact dir (use a Railway Volume mount if not using S3):
# WAX_ARTIFACT_ROOT=/data/wax-artifacts

# --- Workspace / terminal (Railway Volume required for durable media) ---
# Mount a Railway Volume at /data, then:
WORKSPACE_ROOT=/data/wax-workspaces
WAX_WORKSPACE_ROOT=/data/wax-workspaces
# Fail closed if the volume is missing (recommended in production):
REQUIRE_PERSISTENT_WORKSPACE=true
# tmp/cache scavenger only — does NOT expire student Worlds
WORKSPACE_TMP_TTL_HOURS=48

# --- Worker ---
WORK_POLL_INTERVAL_SECONDS=1
WORK_STALE_SECONDS=300
WORK_MAX_RETRIES=3
SCHEDULER_POLL_INTERVAL_SECONDS=5

# --- Rate protection (burst-tolerant; accepted messages are never discarded) ---
RATE_LIMIT_ENABLED=true
RATE_BURST_CAPACITY=12
RATE_SUSTAINED_PER_MINUTE=30
RATE_WINDOW_SECONDS=60
RATE_COOLDOWN_SECONDS=15
RATE_QUEUE_LIMIT_PER_PRINCIPAL=40

# --- Recovery / outage awareness ---
RECOVERY_BATCH_WINDOW_SECONDS=90
RECOVERY_MAX_BATCH_SIZE=8
RECOVERY_POLL_INTERVAL_SECONDS=5
OUTAGE_AWARENESS_MIN_SECONDS=30

# --- Conversational check-in (AI decides natural moment; infra enforces gates) ---
CHECKIN_ENABLED=true
CHECKIN_MIN_MESSAGES=25
CHECKIN_COOLDOWN_HOURS=72
CHECKIN_MAX_PER_WEEK=2
CHECKIN_SUPPRESS_ON_ACTIVE_PROBLEM=true
CHECKIN_SUPPRESS_AFTER_FEEDBACK_SECONDS=300

# --- Feedback / student-specific evidence ---
FEEDBACK_MIN_CONFIDENCE_FOR_PREFERENCE=0.55
FEEDBACK_EVIDENCE_DECAY_DAYS=90
WEB_FEEDBACK_ENABLED=true

# --- Optional research search provider ---
# WAX_SEARCH_URL=https://your-search-api/search

# --- Logging ---
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true

# --- Context Intelligence (independent of PRIMARY tutor model) ---
# Set true only if you intentionally want CI to reuse PRIMARY_* credentials

# Student World must be durable in production (not /tmp)
# WAX_WORKSPACE_ROOT=/data/wax-workspaces
# REQUIRE_PERSISTENT_WORKSPACE=true
