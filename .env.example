# =============================================================================
# WAX Prep — deployment contract (every variable is read by runtime code)
# =============================================================================
# After deploy, set PUBLIC_BASE_URL to your Railway WEB service URL.
# =============================================================================

# --- App ---
APP_ENV=production
APP_NAME=WAX Prep
SECRET_KEY=GENERATE_A_LONG_RANDOM_STRING
PUBLIC_BASE_URL=https://YOUR-WEB-SERVICE.up.railway.app
# Optional dedicated Surface host (leave empty for same-origin Surfaces):
SURFACE_PUBLIC_ORIGIN=

# --- Database (Railway: reference variable from Postgres service) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Intelligence (one chat path) ---
PRIMARY_PROVIDER=openai
PRIMARY_API_KEY=
PRIMARY_BASE_URL=
PRIMARY_MODEL=gpt-4o-mini
PRIMARY_TIMEOUT_SECONDS=60
PRIMARY_MAX_RETRIES=2
# Optional same-task resilience if primary fails (not a second brain):
FALLBACK_PROVIDER=none
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_TIMEOUT_SECONDS=60
FALLBACK_MAX_RETRIES=2

# --- WhatsApp Cloud API ---
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=wax-default-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MAX_MESSAGE_CHARS=3500

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_MESSAGE_CHARS=4000

# --- Artifact storage ---
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# WAX_STORAGE_BACKEND=s3
WAX_S3_BUCKET=
WAX_S3_ENDPOINT=
WAX_S3_REGION=auto
WAX_S3_ACCESS_KEY=
WAX_S3_SECRET_KEY=
WAX_S3_PREFIX=wax/
# WAX_ARTIFACT_ROOT=/data/wax-artifacts

# --- World (durable volume required in production) ---
WORKSPACE_ROOT=/data/wax-workspaces
# Alias also read by layout code:
# WAX_WORKSPACE_ROOT=/data/wax-workspaces
REQUIRE_PERSISTENT_WORKSPACE=true
WORKSPACE_TMP_TTL_HOURS=48
WORKSPACE_MAX_FILE_BYTES=25000000
ISOLATION_ENABLED=true
ISOLATION_TIMEOUT_SECONDS=45
ISOLATION_MAX_OUTPUT_BYTES=150000
ISOLATION_CPU_SECONDS=20
ISOLATION_MEMORY_BYTES=536870912
ISOLATION_REQUIRE_SANDBOX=false
ISOLATION_USE_DOCKER=false

# --- Worker / scheduler / delivery ---
WORK_POLL_INTERVAL_SECONDS=1
WORK_STALE_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=5
DELIVERY_CHUNK_DELAY_SECONDS=0.55

# --- Rate protection ---
RATE_LIMIT_ENABLED=true
RATE_BURST_CAPACITY=12
RATE_SUSTAINED_PER_MINUTE=30
RATE_WINDOW_SECONDS=60
RATE_COOLDOWN_SECONDS=15
RATE_QUEUE_LIMIT_PER_PRINCIPAL=40

# --- Recovery / outage ---
RECOVERY_BATCH_WINDOW_SECONDS=90
RECOVERY_MAX_BATCH_SIZE=8
RECOVERY_POLL_INTERVAL_SECONDS=5
OUTAGE_AWARENESS_MIN_SECONDS=30
PROVIDER_RATE_LIMIT_MAX_RETRIES=48

# --- Security / webhooks ---
WEBHOOK_SIGNATURE_REQUIRED=true

# --- Logging ---
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
